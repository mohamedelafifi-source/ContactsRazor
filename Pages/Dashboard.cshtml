@page
@model DashboardModel
@using ContactsRazor.Helpers
@{
    ViewData["Title"] = "Dashboard";
}

@section HeadMeta {
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, max-age=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="Thu, 01 Jan 1970 00:00:00 GMT" />
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="jumbotron bg-light p-5 rounded mb-4">
                <h1 class="display-4">Welcome, @User.GetUsername()!</h1>
                <p class="lead">Golf Application Dashboard</p>
                <hr class="my-4">
                @if (User.IsFederation())
                {
                    <p>You are logged in as <strong>Federation</strong> - You have access to all clubs' data.</p>
                }
                else if (User.IsClubCaptain())
                {
                    <p>You are logged in as <strong>Club Captain</strong> for Club @User.GetClubCode()</p>
                    <p>You can access your club's data only.</p>
                }
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">👥 Players Management</h5>
                            <p class="card-text">Add and manage players for your club.</p>
                            <a href="/Players" class="btn btn-primary">Manage Players</a>
                        </div>
                    </div>
                </div>
                @if (User.IsClubCaptain())
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">📊 Enter Results</h5>
                                <p class="card-text">Enter and manage competition results.</p>
                                <a href="/Results" class="btn btn-success">Enter Results</a>
                            </div>
                        </div>
                    </div>
                }
                @if (User.IsFederation())
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">👤 User Management</h5>
                                <p class="card-text">View all users in the system.</p>
                                <a href="/Users" class="btn btn-warning">Manage Users</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (User.IsFederation())
            {
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">🔧 Results Management</h5>
                                <p class="card-text">Backup, restore, or clear competition results.</p>
                                <a href="/ResultsManagement" class="btn btn-info">Manage Results</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
