@page
@model DashboardModel
@using ContactsRazor.Helpers
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="jumbotron bg-light p-5 rounded mb-4">
                <h1 class="display-4">Welcome, @User.GetUsername()!</h1>
                <p class="lead">Golf Application Dashboard</p>
                <hr class="my-4">
                @if (User.IsFederation())
                {
                    <p>You are logged in as <strong>Federation</strong> - You have access to all clubs' data.</p>
                }
                else if (User.IsClubCaptain())
                {
                    <p>You are logged in as <strong>Club Captain</strong> for Club @User.GetClubCode()</p>
                    <p>You can access your club's data only.</p>
                }
            </div>

            @if (User.IsFederation())
            {
                <div class="card mb-4 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0">⚙️ Federation Configuration</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">Load clubs and users from configuration files in the root directory.</p>
                        <div class="row">
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="LoadClubs" onsubmit="return confirm('This will load clubs from clubs.txt. Continue?');">
                                    <button type="submit" class="btn btn-primary w-100">
                                        📁 Load Clubs
                                    </button>
                                    <small class="text-muted d-block mt-2">Loads from: clubs.txt (Format: CLUBCODE|LONGNAME)</small>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form method="post" asp-page-handler="LoadUsers" onsubmit="return confirm('This will load users from users.txt. Continue?');">
                                    <button type="submit" class="btn btn-success w-100">
                                        👥 Load Users
                                    </button>
                                    <small class="text-muted d-block mt-2">Loads from: users.txt (Format: USERNAME|PASSWORD|CLUBCODE)</small>
                                </form>
                            </div>
                        </div>
                        <div class="mt-3">
                            <small class="text-muted">
                                <strong>Note:</strong> Place clubs.txt and users.txt files in the application root directory before loading.
                            </small>
                        </div>
                    </div>
                </div>
            }

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Contacts Management</h5>
                            <p class="card-text">Manage contacts for your club.</p>
                            <a href="/Contacts" class="btn btn-primary">Go to Contacts</a>
                        </div>
                    </div>
                </div>
                @if (User.IsFederation())
                {
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">User Management</h5>
                                <p class="card-text">View and manage users.</p>
                                <a href="/Users" class="btn btn-warning">Manage Users</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
