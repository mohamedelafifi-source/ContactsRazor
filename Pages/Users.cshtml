@page
@model ContactsRazor.Pages.UsersModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <h2 class="mb-4">User Management</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Create New User -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Create New User</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="NewUser.Username" class="form-label"></label>
                            <input asp-for="NewUser.Username" class="form-control" />
                            <span asp-validation-for="NewUser.Username" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="NewUser.Password" class="form-label"></label>
                            <input asp-for="NewUser.Password" type="password" class="form-control" />
                            <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="NewUser.ClubCode" class="form-label"></label>
                            <select asp-for="NewUser.ClubCode" class="form-select">
                                <option value="">-- Select Club Code --</option>
                                <option value="FEDERE">FEDERE (Federation)</option>
                                @foreach (var club in Model.AllClubs.Where(c => c.ClubCode != "FEDERE"))
                                {
                                    <option value="@club.ClubCode">@club.ClubCode - @club.LongName</option>
                                }
                            </select>
                            <span asp-validation-for="NewUser.ClubCode" class="text-danger"></span>
                            <small class="text-muted">Select FEDERE for Federation access, or CLB001-CLB010 for club access</small>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Create User</button>
            </form>
        </div>
    </div>

    <!-- Import Users from File -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Import Users from File</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>CSV Import</h6>
                    <form method="post" asp-page-handler="ImportCsv" enctype="multipart/form-data">
                        <div class="mb-3">
                            <input type="file" name="csvFile" accept=".csv" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success">Import CSV</button>
                        <a href="?handler=DownloadTemplate&format=csv" class="btn btn-outline-secondary">Download CSV Template</a>
                    </form>
                </div>
                <div class="col-md-6">
                    <h6>JSON Import</h6>
                    <form method="post" asp-page-handler="ImportJson" enctype="multipart/form-data">
                        <div class="mb-3">
                            <input type="file" name="jsonFile" accept=".json" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-success">Import JSON</button>
                        <a href="?handler=DownloadTemplate&format=json" class="btn btn-outline-secondary">Download JSON Template</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Users List -->
    <div class="card">
        <div class="card-header">
            <h5>All Users (@Model.AllUsers.Count)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Access Type</th>
                            <th>Club Code</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.AllUsers)
                        {
                            <tr>
                                <td>@user.Username</td>
                                <td>
                                    @if (user.IsFederation)
                                    {
                                        <span class="badge bg-warning text-dark">Federation</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Club Captain</span>
                                    }
                                </td>
                                <td><strong>@user.ClubCode</strong></td>
                                <td>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" 
                                          onsubmit="return confirm('Are you sure you want to delete user @user.Username?');" 
                                          class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
