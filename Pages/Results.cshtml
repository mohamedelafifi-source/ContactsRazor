@page
@model ContactsRazor.Pages.ResultsModel
@{
    ViewData["Title"] = "Enter Results";
}

<div class="container mt-4">
    <!-- Club Information Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h2 class="card-title mb-1">@(Model.CurrentClub?.ClubCode ?? "N/A") - @(Model.CurrentClub?.LongName ?? "N/A")</h2>
                    <p class="card-text mb-0">Results Management</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Mode Selection (if no result set selected) -->
    @if (Model.Mode == "existing" && Model.CurrentResultSet == null)
    {
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">Select Result Set</h4>
                    </div>
                    <div class="card-body">
                        @if (Model.ExistingResultSets.Any())
                        {
                            <div class="list-group">
                                @foreach (var resultSet in Model.ExistingResultSets)
                                {
                                    <a href="/Results?mode=existing&resultSetId=@resultSet.Id" class="list-group-item list-group-item-action">
                                        @resultSet.DisplayText
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No existing result sets found.</p>
                            <a href="/Results?mode=new" class="btn btn-primary">Create New Result Set</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- New Result Set Form (if mode is "new" and no result set selected) -->
    @if (Model.Mode == "new" && Model.CurrentResultSet == null)
    {
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">New Results</h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="NewResultSet">
                            <div class="mb-3">
                                <label asp-for="ResultSetInput.Date" class="form-label"></label>
                                <input asp-for="ResultSetInput.Date" class="form-control" type="date" />
                                <span asp-validation-for="ResultSetInput.Date" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ResultSetInput.VenueClubCode" class="form-label"></label>
                                <select asp-for="ResultSetInput.VenueClubCode" class="form-select">
                                    <option value="">-- Select Venue (Club) --</option>
                                    @foreach (var club in Model.Clubs)
                                    {
                                        <option value="@club.ClubCode">@club.LongName</option>
                                    }
                                </select>
                                <span asp-validation-for="ResultSetInput.VenueClubCode" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="submit" class="btn btn-primary">Create</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Result Entry Form (when result set is selected) -->
    @if (Model.CurrentResultSet != null)
    {
        <div class="row mb-4">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">
                            @if (Model.CurrentResultEntry != null)
                            {
                                <span>Result Entry @Model.CurrentResultEntryIndex of @Model.TotalResultEntries</span>
                            }
                            else
                            {
                                <span>New Result Entry</span>
                            }
                            <small class="text-muted ms-2">
                                (@(Model.CurrentResultSet.VenueClub?.LongName ?? Model.CurrentResultSet.VenueClubCode) - @Model.CurrentResultSet.Date.ToString("yyyy-MM-dd"))
                            </small>
                        </h4>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="AddUpdateEntry">
                            <input type="hidden" asp-for="ResultSetInput.ResultSetId" />
                            <input type="hidden" asp-for="ResultEntryInput.ResultEntryId" />
                            
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="ResultEntryInput.PlayerId" class="form-label"></label>
                                <select asp-for="ResultEntryInput.PlayerId" asp-items="Model.Players" class="form-select">
                                    <option value="">-- Select Player --</option>
                                </select>
                                <span asp-validation-for="ResultEntryInput.PlayerId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ResultEntryInput.HCP" class="form-label"></label>
                                <input asp-for="ResultEntryInput.HCP" class="form-control" type="number" step="0.1" placeholder="0.0" />
                                <span asp-validation-for="ResultEntryInput.HCP" class="text-danger"></span>
                                <small class="form-text text-muted">Format: xx.x (e.g., 9.4, 21.0)</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ResultEntryInput.Result" class="form-label"></label>
                                <input asp-for="ResultEntryInput.Result" class="form-control" type="number" min="0" max="50" placeholder="0" />
                                <span asp-validation-for="ResultEntryInput.Result" class="text-danger"></span>
                                <small class="form-text text-muted">Maximum value: 50</small>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                                <div>
                                    @if (Model.PreviousResultEntryId.HasValue)
                                    {
                                        <a href="/Results?mode=existing&resultSetId=@Model.CurrentResultSet.Id&entryId=@Model.PreviousResultEntryId" class="btn btn-secondary">← Previous</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary" disabled>← Previous</button>
                                    }
                                    
                                    @if (Model.NextResultEntryId.HasValue)
                                    {
                                        @if (Model.NextResultEntryId == -1)
                                        {
                                            <a href="/Results?mode=existing&resultSetId=@Model.CurrentResultSet.Id&entryId=-1" class="btn btn-secondary">Next →</a>
                                        }
                                        else
                                        {
                                            <a href="/Results?mode=existing&resultSetId=@Model.CurrentResultSet.Id&entryId=@Model.NextResultEntryId" class="btn btn-secondary">Next →</a>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary" disabled>Next →</button>
                                    }
                                </div>
                                
                                <div>
                                    <button type="submit" class="btn btn-primary">Update</button>
                                </div>
                            </div>
                        </form>
                        
                        @if (Model.ResultEntryInput.ResultEntryId > 0)
                        {
                            <div class="mt-2">
                                <form method="post" asp-page-handler="DeleteEntry" asp-route-id="@Model.ResultEntryInput.ResultEntryId" asp-route-resultSetId="@Model.CurrentResultSet.Id" 
                                      onsubmit="return confirm('Are you sure you want to delete this result entry?');" 
                                      class="d-inline">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Mode Selection Buttons (at bottom) -->
    <div class="row mt-4">
        <div class="col-md-8 mx-auto text-center">
            <div class="btn-group" role="group">
                <a href="/Results?mode=new" class="btn @(Model.Mode == "new" ? "btn-primary" : "btn-outline-primary")">New Results</a>
                <a href="/Results?mode=existing" class="btn @(Model.Mode == "existing" ? "btn-primary" : "btn-outline-primary")">Update Results</a>
            </div>
            <div class="mt-3">
                <a href="/Dashboard" class="btn btn-secondary">Exit to Dashboard</a>
            </div>
        </div>
    </div>

    <!-- Placeholder for PDF Import (Future Feature) -->
    <div class="row mt-4">
        <div class="col-md-8 mx-auto">
            <div class="card border-warning">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Import from PDF (Coming Soon)</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-0">PDF import functionality will be available in a future update.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
