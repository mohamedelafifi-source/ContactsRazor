@page
@model LogoutModel
@{
    ViewData["Title"] = "Logout";
}

<meta http-equiv="refresh" content="0;url=/Login?logout=1&t=@DateTimeOffset.UtcNow.Ticks" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Logging out...</h5>
                    <p class="card-text">Please wait while you are redirected to the login page.</p>
                    <a href="/Login?logout=1&t=@DateTimeOffset.UtcNow.Ticks" class="btn btn-primary">Click here if you are not redirected</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Force redirect immediately
    window.location.href = '/Login?logout=1&t=' + new Date().getTime();
</script>
